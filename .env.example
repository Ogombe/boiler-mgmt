# ============================================
# Boiler Management System - Environment Variables
# ============================================
#
# HOW TO SET UP NEON POSTGRESQL:
# 1. Go to https://console.neon.tech and sign up / log in
# 2. Click "Create Project"
# 3. Choose a region closest to your users (e.g. AWS Africa (Cape Town) for Kenya)
# 4. Copy the connection string - it looks like:
#    postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# 5. Paste it below as DATABASE_URL
# 6. For DIRECT_URL, add -direct to the host:
#    postgresql://user:password@ep-xxx-direct.region.aws.neon.tech/neondb?sslmode=require
#
# ALTERNATIVE - Use neonctl CLI:
#   npm i -g neonctl
#   neonctl auth
#   neonctl projects create --name boiler-mgmt
#   neonctl connection-string  (copy the output)
#
# ============================================

# Neon PostgreSQL - Pooled connection (for app runtime / Vercel)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Neon PostgreSQL - Direct connection (for migrations only)
DIRECT_URL="postgresql://user:password@ep-xxx-direct.region.aws.neon.tech/neondb?sslmode=require"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"
